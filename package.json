{
  "name": "starlight-theme-apple-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Apple Developer Documentation-inspired theme for Astro Starlight.",
  "homepage": "https://github.com/acsandmann/starlight-theme-apple",
  "bugs": {
    "url": "https://github.com/acsandmann/starlight-theme-apple/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acsandmann/starlight-theme-apple.git"
  },
  "license": "MIT",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd docs dev",
    "build": "bun run --cwd docs build",
    "publish:package": "npm publish --access public --workspace starlight-theme-apple"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1"
  },
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.2"
  }
}
