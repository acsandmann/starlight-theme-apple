---
const label = Astro.locals.t("themeSelect.accessibleLabel");
---

<button class="apple-theme-toggle" type="button" aria-label={label}>
  <svg class="apple-theme-toggle__light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
  </svg>
  <svg class="apple-theme-toggle__dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2v16a8 8 0 0 1 0-16Z" />
  </svg>
</button>

<script>
  const media = matchMedia("(prefers-color-scheme: light)");
  function updateButtons() {
    document.querySelectorAll<HTMLButtonElement>(".apple-theme-toggle").forEach((button) => {
      button.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
    });
  }
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest(".apple-theme-toggle")) return;
    const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("starlight-theme", theme);
    updateButtons();
  });
  media.addEventListener("change", () => {
    if (!localStorage.getItem("starlight-theme")) {
      document.documentElement.dataset.theme = media.matches ? "light" : "dark";
      updateButtons();
    }
  });
  document.addEventListener("astro:page-load", updateButtons);
  updateButtons();
</script>
