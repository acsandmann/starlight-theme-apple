---
const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

{
  (prev || next) && (
    <div class="apple-pagination print:hidden" dir={dir}>
      {prev && (
        <a href={prev.href} rel="prev">
          <span class="apple-pagination__label">
            {Astro.locals.t("page.previousLink")}
          </span>
          <span class="apple-pagination__title">{prev.label}</span>
        </a>
      )}
      {next && (
        <a href={next.href} rel="next">
          <span class="apple-pagination__label">
            {Astro.locals.t("page.nextLink")}
          </span>
          <span class="apple-pagination__title">{next.label}</span>
        </a>
      )}
    </div>
  )
}
