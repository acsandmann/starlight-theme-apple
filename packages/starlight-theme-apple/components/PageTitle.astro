---
import { breadcrumbs } from "../libs/breadcrumbs";

const { entry, sidebar, siteTitle, siteTitleHref } =
  Astro.locals.starlightRoute;
const crumbs = breadcrumbs(sidebar, siteTitle, siteTitleHref);
---

{
  crumbs.length > 0 && (
    <nav
      class="apple-breadcrumbs"
      aria-label={Astro.locals.t("starlightThemeApple.breadcrumbs")}
    >
      <ol>
        {crumbs.map((crumb) => (
          <li>
            {crumb.href ? (
              <a href={crumb.href}>{crumb.label}</a>
            ) : (
              <span>{crumb.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
<h1 id="_top" class="apple-page-title">{entry.data.title}</h1>
