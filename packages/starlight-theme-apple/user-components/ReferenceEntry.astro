---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  /** Element to render. Use `article` for self-contained entries such as releases. */
  as?: "section" | "article" | "div";
}

const { as: Tag = "section", class: className, ...attrs } = Astro.props;
---

<Tag class:list={["apple-entry", className]} {...attrs}><slot /></Tag>
